{
  "sourceLanguage" : "en",
  "strings" : {
    "%@" : {
      "comment" : "Text from the library or the app, shown as it is."
    },
    "%@ Saved to your Jellyfin account, so your other Jellyfin apps follow them too." : {
      "comment" : "Footer under the language settings: what the subtitle mode does, then where they're saved."
    },
    "%@ These caps are for %@; each server keeps its own." : {
      "comment" : "Settings footer under the streaming quality caps with more than one server: the caps, then whose.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ These caps are for %2$@; each server keeps its own."
          }
        }
      }
    },
    "%@ downloaded" : {
      "comment" : "Under Cancel Download: how much has arrived, such as 42% downloaded."
    },
    "%@ per episode" : {
      "comment" : "A show's run time: how long its episodes run on average, such as 45 min per episode."
    },
    "%@ uses HTTP, so your sign-in and what you watch cross your network unencrypted. Only connect on a network you trust, like your home Wi-Fi." : {
      "comment" : "Warning before connecting over plain HTTP. The argument is the server's name."
    },
    "%@ · %@" : {
      "comment" : "A title's kind and year in Siri, Shortcuts and Spotlight, such as Movie · 2010.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ · S%lld E%lld" : {
      "comment" : "A downloaded episode's series, season and episode, such as Sherlock Holmes · S1 E3.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · S%2$lld E%3$lld"
          }
        }
      }
    },
    "%@, %@" : {
      "comment" : "Spoken value of a library's sort button: what it sorts by, then which way, such as Name, A to Z.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@"
          }
        }
      }
    },
    "%@. %@" : {
      "comment" : "Two sentences in a row: a title, then what follows it, such as Can't Reach the Server. Check that the server is running. Siri says this when something fails, and VoiceOver reads it when a banner appears on Home.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@. %2$@"
          }
        }
      }
    },
    "%lld Episodes" : {
